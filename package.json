{
  "name": "@cloudpayx/x402-pay",
  "version": "0.2.4",
  "type": "module",
  "description": "XRPL-native x402 payment SDK for autonomous AI agents. Secure, wallet-agnostic XRP, RLUSD and Circle USDC payments with spending policies and verified settlement.",
  "dependencies": {
    "@x402/core": "2.28.0",
    "@x402/fetch": "2.28.0",
    "@x402/xrpl": "2.28.0",
    "xrpl": "4.7.0"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test:policy": "tsc -p tsconfig.guard.json && node --test tests/*.test.mjs",
    "demo:dry-run": "tsc -p tsconfig.policy.json && node examples/simulation-only.mjs",
    "test:signing-guard": "tsc -p tsconfig.guard.json && node --test tests/guard.test.mjs"
  },
  "main": "./scripts/public-node.mjs",
  "types": "./types/public-node.d.ts",
  "exports": {
    ".": {
      "types": "./types/public-node.d.ts",
      "node": "./scripts/public-node.mjs",
      "default": "./scripts/public-node.mjs"
    }
  },
  "files": [
    "dist/src/",
    "scripts/public-node.mjs",
    "scripts/secure-node-purchase.mjs",
    "scripts/durable-purchase-lifecycle.mjs",
    "scripts/local-attempt-journal.mjs",
    "scripts/persistent-spending-budget.mjs",
    "scripts/safe-agent-fetch.mjs",
    "scripts/trusted-xrpl-primitives.mjs",
    "scripts/trusted-xrpl-recovery.mjs",
    "types/",
    "README.md",
    "examples/quickstart-validation.mjs"
  ]
}
